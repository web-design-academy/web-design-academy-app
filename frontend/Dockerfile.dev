FROM node:22-alpine

WORKDIR /app

COPY Web-Visual-Editor/VisualEditor ./Web-Visual-Editor/VisualEditor

WORKDIR /app/Web-Visual-Editor/VisualEditor
RUN npm ci

WORKDIR /app/frontend

COPY frontend/package*.json ./
RUN npm ci

COPY frontend/ ./

ENV PORT=5173

EXPOSE 5173

CMD ["npm", "run", "dev", "--", "--host"]
