{
  "name": "@wda/frontend",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "pnpm --filter @wda/visual-editor build && pnpm --filter @wda/css-analysis build && vite",
    "build": "pnpm --filter @wda/visual-editor build && pnpm --filter @wda/css-analysis build && tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint --fix .",
    "style": "prettier -w .",
    "ts:check": "tsc -b --noEmit"
  },
  "dependencies": {
    "@dnd-kit/core": "^6.3.1",
    "@dnd-kit/sortable": "^10.0.0",
    "@dnd-kit/utilities": "^3.2.2",
    "@mdx-js/mdx": "^3.1.1",
    "@mdx-js/react": "^3.1.1",
    "@monaco-editor/react": "^4.7.0",
    "@react-oauth/google": "^0.13.5",
    "@tanstack/react-query": "^5.107.1",
    "@types/mdx": "^2.0.14",
    "@wda/css-analysis": "workspace:*",
    "@wda/ui-styles": "workspace:*",
    "@wda/visual-editor": "workspace:*",
    "culori": "^4.0.2",
    "jszip": "^3.10.2",
    "lucide-react": "^1.73.0",
    "monaco-editor": "^0.57.0",
    "re-resizable": "^6.11.2",
    "react": "^19.3.1",
    "react-colorful": "^5.8.1",
    "react-dom": "^19.3.1",
    "react-router": "^8.5.1"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/culori": "^4.0.1",
    "@types/node": "^26.6.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@types/wicg-file-system-access": "^2023.10.7",
    "@vitejs/plugin-react": "^6.3.0",
    "eslint": "^10.15.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.8",
    "globals": "^17.14.0",
    "prettier": "^3.10.1",
    "typescript": "~5.9.3",
    "typescript-eslint": "^8.72.2",
    "vite": "^8.3.8"
  }
